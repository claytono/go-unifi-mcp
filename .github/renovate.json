{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>claytono/renovate-config"],
  "postUpdateOptions": ["gomodUpdateImportPaths"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.go-unifi-version$/"],
      "matchStrings": ["(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "filipowm/go-unifi",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["go_(?<major>\\d+)_(?<minor>\\d+)"],
      "currentValueTemplate": "{{{major}}}.{{{minor}}}",
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)",
      "autoReplaceStringTemplate": "go_{{{newMajor}}}_{{{newMinor}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^go\\.mod$/"],
      "matchStrings": ["\\ngo (?<major>\\d+)\\.(?<minor>\\d+)\\.\\d+\\n"],
      "currentValueTemplate": "{{{major}}}.{{{minor}}}",
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)",
      "autoReplaceStringTemplate": "\ngo {{{newMajor}}}.{{{newMinor}}}.0\n"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "pname\\s*=\\s*\"go-test-coverage\";[\\s\\S]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "depNameTemplate": "vladopajic/go-test-coverage",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "mkMcpCli\\s*=\\s*pkgs:\\s*let\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "depNameTemplate": "philschmid/mcp-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "mkMcpPublisher\\s*=\\s*pkgs:\\s*let\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "depNameTemplate": "modelcontextprotocol/registry",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "pname\\s*=\\s*\"python-kacl\";[\\s\\S]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "depNameTemplate": "schmieder.matthias/python-kacl",
      "datasourceTemplate": "gitlab-tags",
      "registryUrlTemplate": "https://gitlab.com"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge Go patch and digest updates",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge Docker digest updates",
      "matchDatasources": ["docker", "custom.docker-first-seen"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "description": "The go.mod go directive is bumped by the golang regex manager alongside flake.nix",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    }
  ]
}

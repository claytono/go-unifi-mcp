#!/usr/bin/env python3
"""Refresh fixed-output source hashes for every flake devShell tool.

The sources are prefetched directly instead of relying on a failed build to
report hash mismatches. This prevents a binary cache from masking a version
bump that retained the previous version's hash.

This complements determinate-nixd fix-hashes, which handles build-derived
hashes such as buildGoModule vendorHash values.
"""

import json
import subprocess
import sys
from pathlib import Path

FLAKE_FILE = Path("flake.nix")

# Nix expression that extracts package source info across all platforms.
# Returns source details for every devShell input on every supported system.
NIX_EVAL_EXPR = r"""
let
  flake = builtins.getFlake "git+file://${toString ./.}";
  systems = builtins.attrNames flake.devShells;
  getPkgInfo = system:
    let
      inputs = flake.devShells.${system}.default.nativeBuildInputs or [];
      refreshable = builtins.filter (pkg: pkg.refreshSourceHash or false) inputs;
    in
      map (pkg:
        let
          hasSrc = pkg ? src;
          url =
            if hasSrc
            then (pkg.src.url or (builtins.head (pkg.src.urls or [""])))
            else "";
          hash = if hasSrc then (pkg.src.outputHash or "") else "";
          mode = if hasSrc then (pkg.src.outputHashMode or "") else "";
        in
          { pname = pkg.pname or "unknown"; inherit url hash mode system; }
      ) refreshable;
in
  builtins.concatMap getPkgInfo systems
"""


def run_nix(args, check=True):
    """Run a nix command and return the result."""
    cmd = ["nix"] + list(args)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, check=check)
    except subprocess.CalledProcessError as e:
        print(f"Error running: {cmd}", file=sys.stderr)
        print(f"Stderr: {e.stderr}", file=sys.stderr)
        raise


def get_all_package_sources():
    """Use nix eval to get source info for all packages across all platforms."""
    result = run_nix(["eval", "--impure", "--json", "--expr", NIX_EVAL_EXPR])
    return json.loads(result.stdout)


def unique_source_entries(sources):
    """Return one entry for each distinct source derivation."""
    entries = {}
    for entry in sources:
        if not entry["url"] or not entry["hash"]:
            continue
        key = (entry["url"], entry["hash"], entry["mode"])
        entries.setdefault(key, entry)
    return list(entries.values())


def prefetch_url(url, mode):
    """Prefetch a flat or recursive source and return its SRI hash."""
    args = ["store", "prefetch-file", "--json", "--hash-type", "sha256"]
    if mode == "recursive":
        args.append("--unpack")
    elif mode != "flat":
        raise ValueError(f"Unsupported fixed-output hash mode: {mode!r}")
    args.append(url)
    result = run_nix(args)
    return json.loads(result.stdout)["hash"]


def find_hash_updates(entries):
    """Prefetch entries and return an unambiguous old-to-new hash mapping."""
    actual_hashes = {}
    for entry in entries:
        print(f"Prefetching {entry['pname']} ({entry['system']}): {entry['url']}")
        new_hash = prefetch_url(entry["url"], entry["mode"])
        old_hash = entry["hash"]
        actual_hashes.setdefault(old_hash, set()).add(new_hash)

    ambiguous = {
        old_hash: new_hashes
        for old_hash, new_hashes in actual_hashes.items()
        if len(new_hashes) > 1
    }
    if ambiguous:
        details = ", ".join(
            f"{old_hash} -> {sorted(new_hashes)}"
            for old_hash, new_hashes in sorted(ambiguous.items())
        )
        raise ValueError(f"One configured hash maps to multiple sources: {details}")

    return {
        old_hash: next(iter(new_hashes))
        for old_hash, new_hashes in actual_hashes.items()
        if next(iter(new_hashes)) != old_hash
    }


def main():
    if not FLAKE_FILE.exists():
        print(f"Error: {FLAKE_FILE} not found", file=sys.stderr)
        sys.exit(1)

    print("Evaluating flake to discover package sources...")
    sources = get_all_package_sources()
    entries = unique_source_entries(sources)
    if not entries:
        print("No fixed-output package sources found")
        return

    content = FLAKE_FILE.read_text(encoding="utf-8")
    updates = find_hash_updates(entries)
    for old_hash, new_hash in updates.items():
        if old_hash not in content:
            raise ValueError(f"Configured hash not found in {FLAKE_FILE}: {old_hash}")
        print(f"Updating hash: {old_hash} -> {new_hash}")
        content = content.replace(old_hash, new_hash)

    if updates:
        FLAKE_FILE.write_text(content, encoding="utf-8")
        print("Updated flake.nix source hashes")
    else:
        print("No source hash changes needed")


if __name__ == "__main__":
    main()
